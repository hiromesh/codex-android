{
  "name": "codex-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop web client for codex app-server, equivalent to the Android app (full-stack: serves UI and proxies WebSockets).",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "serve": "npm run build && npm start"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "express": "^4.21.2",
    "marked": "^15.0.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "bin": {
    "nex": "bin/codex-cli.ts"
  }
}